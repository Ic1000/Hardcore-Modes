local DoorData = {}
local SpeedAutoPrompt = false

local function GetModifierState()
	local env = (getgenv and getgenv()) or _G
	local fasterTrouble = (env.FasterTrouble == true) or (_G.FasterTrouble == true)
	local rebounding = (env.Rebounding == true) or (_G.Rebounding == true)
	local freezingCold = (env.FreezingCold == true) or (_G.FreezingCold == true)

	return {
		FasterTrouble = fasterTrouble,
		Rebounding = rebounding,
		FreezingCold = freezingCold,
		InstantWardrobe = (not fasterTrouble) and (rebounding or freezingCold)
	}
end

local function GetGitSound(GithubSnd, SoundName, parent)
	local url = GithubSnd
	if not isfile(SoundName .. ".mp3") then
		writefile(SoundName .. ".mp3", game:HttpGet(url))
	end
	local sound = Instance.new("Sound")
	sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
	sound.Parent = parent
	return sound
end

local RunService = game:GetService("RunService")

-- Services & Variables
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local currentRooms = workspace:WaitForChild("CurrentRooms")
local hasKeyHitbox = false
local LatestRoom = game:GetService("ReplicatedStorage"):WaitForChild("GameData"):WaitForChild("LatestRoom")

local function SetupDoorNormal(obj)
	if obj:GetAttribute("DoorNormalScanned") then
		return
	end

	task.spawn(function()
		local door
		local knob

		repeat
			if not obj.Parent then
				return
			end

			door = obj:FindFirstChild("Door")
			knob = obj:FindFirstChild("Knob", true)

			if not door or not knob then
				task.wait()
			end
		until door and knob

		if not obj.Parent or not door:IsA("MeshPart") then
			return
		end

		obj:SetAttribute("DoorNormalScanned", true)

		for _, v in ipairs(obj:GetDescendants()) do
			if v:IsA("BasePart") and (v.Name == "Hidden" or v.Name == "Hinge") then
				v.CanCollide = false
				v.Transparency = 1
			end
		end

		local cloneModel = obj:Clone()
		cloneModel.Name = "DoorClone"
		cloneModel.Parent = obj.Parent

		local cloneDoor = cloneModel:FindFirstChild("Door")
		local cloneKnob = cloneModel:FindFirstChild("Knob", true)
		local hidden = cloneModel:FindFirstChild("Hidden", true)
		local hinge = cloneModel:FindFirstChild("Hinge", true)

		if not cloneDoor or not cloneKnob then
			cloneModel:Destroy()
			obj:SetAttribute("DoorNormalScanned", nil)
			return
		end

		local openSound = cloneDoor:FindFirstChild("Open")
		local hitSound = cloneDoor:FindFirstChild("Hit")

		for _, v in ipairs(cloneModel:GetDescendants()) do
			if v:IsA("BasePart") then
				if v.Name == "Hidden" or v.Name == "Hinge" then
					v.CanCollide = false
					v.Transparency = 1
				else
					v.CanCollide = true
					v.Transparency = 0
				end
			end
		end

		local oldCF = cloneDoor.CFrame

		local function GetOpenCF()
			local openAngle = 90

			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if hrp then
				local relative = cloneDoor.CFrame:PointToObjectSpace(hrp.Position)

				if relative.Z > 0 then
					openAngle = -90
				end
			end

			local cf

			if hinge and hinge:IsA("BasePart") then
				local offset = hinge.CFrame:ToObjectSpace(oldCF)

				cf =
					hinge.CFrame
					* CFrame.Angles(0, math.rad(openAngle), 0)
					* offset
			else
				cf = oldCF * CFrame.Angles(0, math.rad(openAngle), 0)
			end

			return cf, openAngle
		end

		local openPrompt = Instance.new("ProximityPrompt")
		openPrompt.Style = Enum.ProximityPromptStyle.Custom
		openPrompt.ActionText = "Open Door"
		openPrompt.ObjectText = "Door"
		openPrompt.MaxActivationDistance = 10
		openPrompt.RequiresLineOfSight = false
		openPrompt.Parent = cloneKnob

		local closePrompt = openPrompt:Clone()
		closePrompt.ActionText = "Close Door"
		closePrompt.Enabled = false
		closePrompt.Parent = cloneKnob

		local hasTriggeredOnce = false

		openPrompt.Triggered:Connect(function()
			local openCF, openAngle = GetOpenCF()

			if not hasTriggeredOnce then
				hasTriggeredOnce = true
			end

			openPrompt.Enabled = false
			closePrompt.Enabled = true

			if openSound and openSound:IsA("Sound") and not SpeedAutoPrompt then
				openSound:Play()
			end

			if hidden then
				hidden.Parent = cloneModel
			end

			TweenService:Create(
				cloneDoor,
				TweenInfo.new(
					2,
					Enum.EasingStyle.Exponential,
					Enum.EasingDirection.Out
				),
				{CFrame = openCF}
			):Play()
		end)

		closePrompt.Triggered:Connect(function()
			closePrompt.Enabled = false

			if hitSound and hitSound:IsA("Sound") then
				hitSound:Play()
			end

			local tween = TweenService:Create(
				cloneDoor,
				TweenInfo.new(
					2,
					Enum.EasingStyle.Exponential,
					Enum.EasingDirection.Out
				),
				{CFrame = oldCF}
			)

			tween:Play()
			tween.Completed:Wait()

			if hidden then
				hidden.Parent = nil
			end

			openPrompt.Enabled = true
		end)

		local busy = false

		openPrompt.PromptShown:Connect(function()
			if not SpeedAutoPrompt or busy or not openPrompt.Enabled then
				return
			end

			busy = true

			fireproximityprompt(openPrompt)

			if openSound then
				local slam = openSound:Clone()
				slam.SoundId = "rbxassetid://9114149321"
				slam.Volume = 1
				slam.Parent = cloneDoor

				slam.Ended:Once(function()
					slam:Destroy()
				end)

				slam:Play()
			end

			task.delay(0.15, function()
				busy = false
			end)
		end)

		door:Destroy()
	end)
end

local function SetupLockedDoor(door)
	if door:GetAttribute("LockedDoorScanned") then
		return
	end

	task.spawn(function()
		local realPrompt

		repeat
			if not door.Parent then
				return
			end

			realPrompt = nil

			for _, v in ipairs(door:GetDescendants()) do
				if v:IsA("ProximityPrompt") and v.Name == "UnlockPrompt" then
					realPrompt = v
					break
				end
			end

			if not realPrompt then
				task.wait()
			end
		until realPrompt

		if not door.Parent then
			return
		end

		local clone = door:Clone()
		clone.Name = "DoorClone"
		clone.Parent = door.Parent

		local cloneDoor
		local cloneKnob
		local hinge

		repeat
			if not door.Parent or not clone.Parent then
				return
			end

			cloneDoor = nil
			cloneKnob = nil
			hinge = nil

			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("BasePart") then
					if v.Name == "Door" then
						cloneDoor = v
					elseif v.Name == "Knob" then
						cloneKnob = v
					elseif v.Name == "Hinge" then
						hinge = v
					end
				end
			end

			if not cloneDoor then
				for _, v in ipairs(clone:GetDescendants()) do
					if v:IsA("Model") and v.Name == "Door" then
						cloneDoor = v:FindFirstChildWhichIsA("BasePart", true)

						if cloneDoor then
							break
						end
					end
				end
			end

			if not cloneKnob or not cloneDoor then
				task.wait()
			end
		until cloneDoor and cloneKnob

		if not door.Parent or not clone.Parent then
			return
		end

		door:SetAttribute("LockedDoorScanned", true)

		for _, v in ipairs(door:GetDescendants()) do
			if v:IsA("BasePart") then
				if v.Name ~= "Lock" and not v:FindFirstAncestor("Lock") then
					v.Transparency = 1
				end

			elseif v:IsA("SurfaceGui") and v.Name == "Sign" then
				v:Destroy()

			elseif v:IsA("Sound") then
				if v.Name ~= "Fall" and v.Name ~= "Unlock" then
					v.Volume = 0
				end
			end
		end

		for _, v in ipairs(clone:GetDescendants()) do
			if v:IsA("BasePart") then
				if v.Name == "Lock" or v.Name == "Hidden" then
					v.Transparency = 1
				end

				if v.Name == "Lock" then
					for _, d in ipairs(v:GetDescendants()) do
						if d:IsA("BasePart") then
							d.Transparency = 1
						elseif d:IsA("ProximityPrompt") then
							d:Destroy()
						end
					end
				end
			end
		end

		local openSound

		for _, v in ipairs(cloneDoor:GetDescendants()) do
			if v:IsA("Sound") and v.Name == "Open" then
				openSound = v
				break
			end
		end

		local bellSound

		for _, v in ipairs(cloneDoor:GetDescendants()) do
			if v:IsA("Sound") and v.Name == "Bell" then
				bellSound = v
				break
			end
		end

		task.spawn(function()
			local customPrompt
			local triggered = false

			while door.Parent and clone.Parent do
				-- Cửa khóa không hỗ trợ SpeedAutoPrompt (giữ khoảng cách 7 cố định & không tự fire theo tốc độ)
				if realPrompt
					and realPrompt.Parent
					and realPrompt.Enabled == false
					and not customPrompt
					and not triggered
					and cloneKnob
					and cloneKnob.Parent then

					customPrompt = Instance.new("ProximityPrompt")
					customPrompt.Style = Enum.ProximityPromptStyle.Custom
					customPrompt.ActionText = "Open Door"
					customPrompt.ObjectText = "Door"
					customPrompt.MaxActivationDistance = 7
					customPrompt.RequiresLineOfSight = false

					-- FIX: prompt phải nằm trên Knob của CLONE
					customPrompt.Parent = cloneKnob

					customPrompt.Triggered:Connect(function()
						if triggered then
							return
						end

						triggered = true

						if not customPrompt or not customPrompt.Parent then
							return
						end

						customPrompt:Destroy()

						for _, v in ipairs(clone:GetDescendants()) do
							if v:IsA("BasePart") and v.Name == "Collision" then
								v.CanCollide = false
							end
						end

						local char =
							LocalPlayer.Character
							or LocalPlayer.CharacterAdded:Wait()

						local hum = char:WaitForChild("Humanoid")
						local hrp = char:WaitForChild("HumanoidRootPart")

						local mod = GetModifierState()
						local oldCF = cloneDoor.CFrame

						local function GetOpenCF()
							local angle = 95

							local relative =
								cloneDoor.CFrame:PointToObjectSpace(
									hrp.Position
								)

							if relative.Z > 0 then
								angle = -95
							end

							if hinge and hinge:IsA("BasePart") then
								local offset =
									hinge.CFrame:ToObjectSpace(oldCF)

								return
									hinge.CFrame
									* CFrame.Angles(
										0,
										math.rad(angle),
										0
									)
									* offset
							else
								return
									oldCF
									* CFrame.Angles(
										0,
										math.rad(angle),
										0
									)
							end
						end

						if mod.FasterTrouble then
							if openSound then
								openSound:Play()
							end

							if bellSound then
								bellSound:Play()
							end

							TweenService:Create(
								cloneDoor,
								TweenInfo.new(
									1,
									Enum.EasingStyle.Exponential,
									Enum.EasingDirection.Out
								),
								{CFrame = GetOpenCF()}
							):Play()
							return
						end

						local cf, size = clone:GetBoundingBox()

						local targetPos =
							cf.Position
							- cf.LookVector * (size.Z / 2 + 2)

						local targetCF =
							CFrame.lookAt(targetPos, cf.Position)

						hum.AutoRotate = false
						hrp.Anchored = true

						local wee = TweenService:Create(
							hrp,
							TweenInfo.new(
								0.7,
								Enum.EasingStyle.Exponential,
								Enum.EasingDirection.Out
							),
							{CFrame = targetCF}
						)

						wee:Play()

						task.spawn(function()
							local Anim = Instance.new("Animation")
							Anim.AnimationId = "rbxassetid://18759987341"

							local Track = hum:LoadAnimation(Anim)
							Track:AdjustSpeed(0.3)
							Track:Play()

							task.wait(0.3)

							if Track then
								Track:AdjustSpeed(0)
							end

							task.wait(0.3)

							if Track then
								Track:AdjustSpeed(0.5)
							end

							task.wait(0.59)
							task.wait(0.01)

							if wee then
								wee:Cancel()
							end

							if hrp.Parent then
								hrp.CFrame =
									hrp.CFrame
									+ hrp.CFrame.LookVector * 8
							end

							Track:Stop()
							Anim:Destroy()
						end)

						task.delay(0.3, function()
							if not clone.Parent then
								return
							end

							if openSound then
								openSound:Play()
							end

							if bellSound then
								bellSound:Play()
							end

							TweenService:Create(
								cloneDoor,
								TweenInfo.new(
									1,
									Enum.EasingStyle.Exponential,
									Enum.EasingDirection.Out
								),
								{CFrame = GetOpenCF()}
							):Play()
						end)

						task.delay(0.4, function()
							if hrp.Parent then
								hrp.Anchored = false
								hum.AutoRotate = true
							end
						end)
					end)

				elseif customPrompt
					and not customPrompt.Parent then

					customPrompt = nil
				end

				task.wait(0.01)
			end
		end)
	end)
end

local function SetupDoor(door)
	if not (
		door:IsA("Model")
		and (door.Name == "Door" or door.Name == "DoorFake")
	) then
		return
	end

	if door:GetAttribute("DoorScanned") then
		return
	end

	task.spawn(function()
		local knob
		local doorHasKeyHitbox = false
		local hasMovableObjects = false

		repeat
			if not door.Parent then
				return
			end

			knob = nil
			doorHasKeyHitbox = false
			hasMovableObjects = false

			for _, v in ipairs(door:GetDescendants()) do
				if v.Name == "KeyHitbox" then
					doorHasKeyHitbox = true
				end

				if v:IsA("BasePart") and v.Name == "Knob" then
					knob = v
				end

				if v.Name:sub(1, 5) == "Func_"
					or v.Name == "ClientOpen"
					or v.Name == "Hidden"
					or v.Name == "Collision" then

					hasMovableObjects = true
				end
			end

			-- KeyHitbox có thể load sau Door
			if not doorHasKeyHitbox and door.Parent then
				for _, v in ipairs(door.Parent:GetDescendants()) do
					if v.Name == "KeyHitbox" then
						doorHasKeyHitbox = true
						break
					end
				end
			end

			if not knob or not hasMovableObjects then
				task.wait()
			end
		until knob and hasMovableObjects

		if not door.Parent then
			return
		end

		-- Nếu KeyHitbox cuối cùng mới xuất hiện thì chuyển sang LockedDoor
		if doorHasKeyHitbox then
			SetupLockedDoor(door)
			return
		end

		if DoorData[door] then
			return
		end

		door:SetAttribute("DoorScanned", true)

		DoorData[door] = {
			Moved = {},
			Prompt = nil,
			AutoMode = false,
			PermanentAuto = false
		}

		local moved = DoorData[door].Moved

		for _, obj in ipairs(door:GetDescendants()) do
			if obj.Name:sub(1, 5) == "Func_"
				or obj.Name == "ClientOpen"
				or obj.Name == "Hidden"
				or obj.Name == "Collision" then

				table.insert(moved, {
					Object = obj,
					Parent = obj.Parent
				})

				obj.Parent = nil
			end
		end

		if #moved == 0 then
			DoorData[door] = nil
			door:SetAttribute("DoorScanned", nil)
			return
		end

		local prompt = Instance.new("ProximityPrompt")
		prompt.Style = Enum.ProximityPromptStyle.Custom
		prompt.ActionText = "Open Door"
		prompt.ObjectText = "Door"
		prompt.MaxActivationDistance =
			SpeedAutoPrompt and 11 or 7
		prompt.RequiresLineOfSight = false
		prompt.Parent = knob

		DoorData[door].Prompt = prompt

		local autoOpen = false

		prompt.PromptShown:Connect(function()
			if SpeedAutoPrompt then
				fireproximityprompt(prompt)
				return
			end

			if autoOpen then
				return
			end

			if not workspace:FindFirstChild("RipperBla") then
				return
			end

			local room = tonumber(door.Parent.Name)

			if not room or room ~= LatestRoom.Value then
				return
			end

			autoOpen = true

			DoorData[door].AutoMode = true
			DoorData[door].PermanentAuto = true

			door:SetAttribute("RipperOpened", true)

			for _, info in ipairs(moved) do
				if info.Object and info.Parent then
					info.Object.Parent = info.Parent
				end
			end

			fireproximityprompt(prompt)
		end)

		prompt.Triggered:Connect(function()
			local room = tonumber(door.Parent.Name)

			if room and room == LatestRoom.Value then
				DoorData[door].AutoMode = true
				DoorData[door].PermanentAuto = true
			end

			prompt:Destroy()

			if workspace:FindFirstChild("RipperBla") then
				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end

				return
			end

			local mod = GetModifierState()
			if SpeedAutoPrompt or mod.FasterTrouble then
				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end

				return
			end

			local char =
				LocalPlayer.Character
				or LocalPlayer.CharacterAdded:Wait()

			local hum = char:WaitForChild("Humanoid")
			local hrp = char:WaitForChild("HumanoidRootPart")

			local cf, size = door:GetBoundingBox()

			local targetPos =
				cf.Position
				- cf.LookVector * (size.Z / 2 + 2)

			local targetCF =
				CFrame.lookAt(targetPos, cf.Position)

			hum.AutoRotate = false
			hrp.Anchored = true

			local wee = TweenService:Create(
				hrp,
				TweenInfo.new(
					0.7,
					Enum.EasingStyle.Exponential,
					Enum.EasingDirection.Out
				),
				{CFrame = targetCF}
			)

			wee:Play()

			task.spawn(function()
				local Anim = Instance.new("Animation")
				Anim.AnimationId = "rbxassetid://18759987341"

				local Track = hum:LoadAnimation(Anim)
				Track:AdjustSpeed(0.3)
				Track:Play()

				task.wait(0.3)

				Track:AdjustSpeed(0)

				task.wait(0.3)

				Track:AdjustSpeed(0.5)

				task.wait(0.59)
				task.wait(0.01)

				wee:Cancel()

				hrp.CFrame =
					hrp.CFrame
					+ hrp.CFrame.LookVector * 8

				Track:Stop()
				Anim:Destroy()
			end)

			task.delay(0.3, function()
				if not door.Parent then
					return
				end

				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end
			end)

			task.delay(0.4, function()
				if hrp.Parent then
					hrp.Anchored = false
					hum.AutoRotate = true
				end
			end)
		end)
	end)
end

local function SetupWardrobe(wardrobe)
	if not (wardrobe:IsA("Model") and wardrobe.Name == "Wardrobe") then
		return
	end

	local mod = GetModifierState()
	if mod.FasterTrouble then
		return
	end

	if wardrobe:GetAttribute("WardrobeScanned") then
		return
	end

	task.spawn(function()
		local main = wardrobe:FindFirstChild("Main", true)
		local hiddenValue = wardrobe:FindFirstChild("HiddenPlayer", true)
		local doors = {}

		repeat
			if not wardrobe.Parent then
				return
			end

			main = wardrobe:FindFirstChild("Main", true)
			hiddenValue = wardrobe:FindFirstChild("HiddenPlayer", true)

			doors = {
				wardrobe:FindFirstChild("Door1"),
				wardrobe:FindFirstChild("Door2")
			}

			if not main or not hiddenValue
				or not doors[1] or not doors[2]
				or not doors[1]:IsA("BasePart")
				or not doors[2]:IsA("BasePart") then
				task.wait()
			end
		until main and hiddenValue
			and doors[1] and doors[2]
			and doors[1]:IsA("BasePart")
			and doors[2]:IsA("BasePart")

		if wardrobe:GetAttribute("Singular") then
			return
		end

		local oldPrompt = wardrobe:FindFirstChildWhichIsA("ProximityPrompt", true)

		if not oldPrompt then
			return
		end

		wardrobe:SetAttribute("WardrobeScanned", true)

		local instantWardrobe = GetModifierState().InstantWardrobe
		local holdTime = instantWardrobe and 0 or 0.25

		oldPrompt.ActionText = "Njkx"
		oldPrompt.Enabled = false
		oldPrompt.HoldDuration = holdTime

		local prompts = {}

		for _, door in ipairs(doors) do
			local open = oldPrompt:Clone()
			open.Name = "openPrompt"
			open.ActionText = "Hide"
			open.HoldDuration = holdTime
			open.Enabled = true
			open.Parent = door

			local close = open:Clone()
			close.Name = "closePrompt"
			close.ActionText = "Close"
			close.HoldDuration = holdTime
			close.Enabled = false
			close.Parent = door

			table.insert(prompts, {
				Open = open,
				Close = close
			})
		end

		local originalEnterSound
		local enterSound
		local exitSound

		local soundEnter = wardrobe:FindFirstChild("SoundEnter", true)
		local soundExit = wardrobe:FindFirstChild("SoundExit", true)

		while wardrobe.Parent and (not soundEnter or not soundExit) do
			task.wait()
			soundEnter = wardrobe:FindFirstChild("SoundEnter", true)
			soundExit = wardrobe:FindFirstChild("SoundExit", true)
		end

		if not wardrobe.Parent then
			return
		end

		for _, v in ipairs(wardrobe:GetDescendants()) do
			if v:IsA("Sound") then
				if v.Name == "SoundEnter" then
					originalEnterSound = v

					enterSound = Instance.new("Sound")
					enterSound.Name = "SoundEnterClone"
					enterSound.RollOffMaxDistance = 30
					enterSound.Volume = 0.7
					enterSound.SoundId = GetGitSound(
						"https://github.com/cakmay227-svg/random/raw/refs/heads/main/openCloset%20new.mp3.oga.mp3?raw=true",
						"jcjiejbhcus",
						workspace
					).SoundId
					enterSound.Parent = v.Parent

				elseif v.Name == "SoundExit" then
					exitSound = v:Clone()
					exitSound.Name = "SoundExitClone"
					exitSound.RollOffMaxDistance = 30
					exitSound.Volume = 0.7
					exitSound.SoundId = GetGitSound(
						"https://github.com/cakmay227-svg/random/raw/refs/heads/main/closeCloset%20new.mp3.oga.mp3?raw=true",
						"kckjjebbcrd",
						workspace
					).SoundId
					exitSound.Parent = v.Parent
				end
			end
		end

		local track
		local checkingMain = false
		local checkingHidden = false
		local state = "open"
		local busy = false

		local function SetPrompts(openEnabled, closeEnabled)
			local currentHold = GetModifierState().InstantWardrobe and 0 or 0.25
			for _, p in ipairs(prompts) do
				p.Open.HoldDuration = currentHold
				p.Close.HoldDuration = currentHold
				p.Open.Enabled = openEnabled
				p.Close.Enabled = closeEnabled
			end
		end

		local function IsNearMain()
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if not hrp then
				return false
			end

			local pos

			if main:IsA("BasePart") then
				pos = main.Position
			elseif main:IsA("Model") then
				pos = main:GetPivot().Position
			else
				return false
			end

			return (hrp.Position - pos).Magnitude < 4
		end

		local function StopMainCheck()
			checkingMain = false
			SetPrompts(false, false)
		end

		local function StartMainCheck()
			if checkingMain then
				return
			end

			checkingMain = true

			task.spawn(function()
				while checkingMain and wardrobe.Parent do
					if state == "close" then
						if IsNearMain() then
							SetPrompts(true, false)
						else
							SetPrompts(false, true)
						end
					end

					task.wait(0.1)
				end

				checkingMain = false
			end)
		end

		local function StopHiddenCheck()
			checkingHidden = false
		end

		local function StartHiddenCheck()
			if checkingHidden or not hiddenValue then
				return
			end

			checkingHidden = true

			task.spawn(function()
				while checkingHidden and wardrobe.Parent do
					if hiddenValue.Value == LocalPlayer.Name then
						SetPrompts(false, false)
					else
						checkingHidden = false
						state = "open"
						SetPrompts(true, false)
						break
					end

					task.wait(0.3)
				end

				checkingHidden = false
			end)
		end

		local function PlayWardrobeAnimation()
			local controller = wardrobe:FindFirstChildOfClass("AnimationController")

			if not controller then
				controller = Instance.new("AnimationController")
				controller.Parent = wardrobe
			end

			local animator = controller:FindFirstChildOfClass("Animator")

			if not animator then
				animator = Instance.new("Animator")
				animator.Parent = controller
			end

			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://9451146136"

			if track then
				track:Stop(0)
				track:Destroy()
				track = nil
			end

			track = animator:LoadAnimation(anim)
			track:Play()
			track:AdjustSpeed(0.8)

			task.spawn(function()
				repeat
					task.wait()
				until not track or track.Length > 0

				if not track then
					anim:Destroy()
					return
				end

				task.wait(track.Length / 2)

				if track and track.IsPlaying then
					track:AdjustSpeed(0)
				end

				anim:Destroy()
			end)
		end

		local function PlayPlayerAnim(id, speed, reverse)
			local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hum = char:WaitForChild("Humanoid")
			local animator = hum:FindFirstChildOfClass("Animator")

			if not animator then
				animator = Instance.new("Animator")
				animator.Parent = hum
			end

			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://" .. id

			local tr = animator:LoadAnimation(anim)
			tr.Priority = Enum.AnimationPriority.Action4
			tr:Play()

			if reverse then
				repeat
					task.wait()
				until tr.Length > 0

				tr.TimePosition = 0.2
				tr:AdjustSpeed(-speed)
				task.wait(0.5)
			else
				tr:AdjustSpeed(speed)
				tr.Stopped:Wait()
			end

			tr:Stop()
			tr:Destroy()
			anim:Destroy()
		end

		local function OpenWardrobe()
			if busy or state ~= "open" then
				return
			end

			busy = true
			state = "close"
			SetPrompts(false, false)
			oldPrompt.Enabled = true

			local brocmon = oldPrompt.Triggered:Connect(function() 
				oldPrompt.Enabled = false
				brocmon:Disconnect() 
			end) 

			local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hum = char:WaitForChild("Humanoid")
			local hrp = char:WaitForChild("HumanoidRootPart")

			local cf, size = wardrobe:GetBoundingBox()
			local pos = cf.Position + cf.LookVector * (size.Z / 2 + 2)
			local target = CFrame.lookAt(pos, cf.Position)

			hum.AutoRotate = false
			hrp.Anchored = true

			local tween = TweenService:Create(
				hrp,
				TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
				{CFrame = target}
			)

			tween:Play()

			task.delay(0.25, function()
				if enterSound then
					enterSound:Play()
				end

				task.spawn(PlayPlayerAnim, "98224925603818", 0.6, false)
				StartMainCheck()
			end)

			task.delay(0.25, function()
				if hrp.Parent then
					hrp.Anchored = false
					hum.AutoRotate = true
				end

				PlayWardrobeAnimation()
				busy = false
			end)
		end

		local function CloseWardrobe()
			if busy or state ~= "close" then
				return
			end

			busy = true
			state = "opening"
			StopMainCheck()
			StopHiddenCheck()
			SetPrompts(false, false)
			oldPrompt.Enabled = false

			local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hum = char:WaitForChild("Humanoid")
			local hrp = char:WaitForChild("HumanoidRootPart")

			local cf, size = wardrobe:GetBoundingBox()
			local pos = cf.Position + cf.LookVector * (size.Z / 2 + 2)
			local target = CFrame.lookAt(pos, cf.Position)

			hum.AutoRotate = false
			hrp.Anchored = true

			local tween = TweenService:Create(
				hrp,
				TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
				{CFrame = target}
			)

			tween:Play()

			task.delay(0.3, function()
				if exitSound then
					exitSound:Play()
				end

				task.spawn(PlayPlayerAnim, "9461439496", 0.6, true)
			end)

			task.delay(0.4, function()
				if hrp.Parent then
					hrp.Anchored = false
					hum.AutoRotate = true
				end

				if track then
					track:AdjustSpeed(0.7)

					task.spawn(function()
						local remaining = track.Length - track.TimePosition
						task.wait(math.max(remaining / 0.7, 0))
						if state == "opening" then
							state = "open"
							SetPrompts(true, false)
						end
						busy = false
					end)
				else
					state = "open"
					SetPrompts(true, false)
					busy = false
				end
			end)
		end

		for _, p in ipairs(prompts) do
			p.Open.Triggered:Connect(OpenWardrobe)
			p.Close.Triggered:Connect(CloseWardrobe)
		end

		oldPrompt.Triggered:Connect(function()
			if originalEnterSound then
				originalEnterSound.Volume = 0
			end

			if exitSound then
				exitSound:Play()
			end

			StopMainCheck()
			StartHiddenCheck()

			if track then
				track:Stop(0)
				track:Destroy()
				track = nil
			end
		end)
	end)
end

local function Process(inst)
	if inst:IsA("Model") then
		if inst.Name == "DoorNormal" then
			SetupDoorNormal(inst)
		elseif inst.Name == "Door" or inst.Name == "DoorFake" then
			SetupDoor(inst)
		elseif inst.Name == "Wardrobe" then
			task.defer(function()
				if not inst.Parent then
					return
				end

				SetupWardrobe(inst)
			end)
		elseif inst.Name == "KeyHitbox" then  
			hasKeyHitbox = true  
		end
	end
end

hasKeyHitbox = currentRooms:FindFirstChild("KeyHitbox", true) ~= nil

for _, v in ipairs(currentRooms:GetDescendants()) do
	Process(v)
end

task.delay(1, function()
	for _, v in ipairs(currentRooms:GetDescendants()) do
		Process(v)
	end
end)

currentRooms.DescendantAdded:Connect(Process)

local function RestoreDoors()
	for door, data in pairs(DoorData) do
		if door.Parent and not data.PermanentAuto then
			for _, info in ipairs(data.Moved) do
				if info.Object and info.Parent then
					info.Object.Parent = info.Parent
				end
			end

			if data.Prompt then  
				data.Prompt.Enabled = false  
			end  
		end  
	end
end

local ripperAlive = false

local function UpdateDoors()
	local alive = workspace:FindFirstChild("RipperBla") ~= nil

	if alive == ripperAlive then  
		return  
	end  

	ripperAlive = alive  

	if alive then  
		RestoreDoors()  
	else  
		for door, data in pairs(DoorData) do  
			if door.Parent then  
				if door:GetAttribute("RipperOpened")   
				or data.PermanentAuto   
				or data.AutoMode then  
					continue  
				end  
			end  
		end  
	end
end

workspace.ChildAdded:Connect(function(obj)
	if obj:IsA("Model") and obj.Name == "RipperBla" then
		UpdateDoors()

		obj.AncestryChanged:Connect(function(_, parent)  
			if not parent then  
				UpdateDoors()  
			end  
		end)  
	end
end)

local function SetupSpeedCheck(char)
	local hum = char:WaitForChild("Humanoid")

	local function Update()
		SpeedAutoPrompt = hum.WalkSpeed > 16

		for _, data in pairs(DoorData) do
			if data.Prompt then
				data.Prompt.MaxActivationDistance = SpeedAutoPrompt and 11 or 7
			end
		end
	end

	Update()

	hum:GetPropertyChangedSignal("WalkSpeed"):Connect(Update)
end

if LocalPlayer.Character then
	task.spawn(SetupSpeedCheck, LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(SetupSpeedCheck)

UpdateDoors() 

print("work")
